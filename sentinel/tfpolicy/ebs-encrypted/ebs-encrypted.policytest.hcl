policytest {
  targets = ["ebs-encrypted.policy.hcl"]
}

resource "aws_ebs_volume" "pass_encrypted_true" {
  attrs = {
    availability_zone = "us-east-1a"
    size              = 10
    encrypted         = true
  }
}

resource "aws_ebs_volume" "pass_encrypted_with_kms" {
  attrs = {
    availability_zone = "us-east-1a"
    size              = 10
    type              = "gp3"
    encrypted         = true
    kms_key_id        = "arn:aws:kms:us-east-1:123456789012:key/abc"
  }
}

resource "aws_ebs_volume" "fail_encrypted_false" {
  expect_failure = true
  attrs = {
    availability_zone = "us-east-1a"
    size              = 10
    encrypted         = false
  }
}

# Missing attribute scenario
resource "aws_ebs_volume" "fail_encrypted_missing" {
  expect_failure = true
  attrs = {
    availability_zone = "us-east-1a"
    size              = 10
  }
}

# Explicit null: policy treats null as non-compliant
resource "aws_ebs_volume" "fail_encrypted_null" {
  expect_failure = true
  attrs = {
    availability_zone = "us-east-1a"
    size              = 10
    encrypted         = null
  }
}

