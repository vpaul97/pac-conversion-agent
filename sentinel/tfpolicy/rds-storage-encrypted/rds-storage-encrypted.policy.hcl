policy {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 6.69.0, < 7.0.0"
    }
  }
}

# Converted from Sentinel: RDS DB instances must have storage encryption enabled.
# Default operations (create, update) match the Sentinel scope; destroy is skipped.
resource_policy "aws_db_instance" "storage_encrypted" {
  locals {
    storage_encrypted_raw = core::try(attrs.storage_encrypted, null)
    is_encrypted          = local.storage_encrypted_raw == true
  }

  enforcement_level = "advisory"
  enforce {
    condition     = local.is_encrypted
    error_message = "RDS DB instances must have storage_encrypted set to true."
  }
}

