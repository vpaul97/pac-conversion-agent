policy {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 6.69.0, < 7.0.0"
    }
  }
}

# EC2 instances must use an approved instance type.
input "allowed_instance_types" {
  type    = list(string)
  default = ["t3.micro", "t3.small", "t3.medium"]
}

resource_policy "aws_instance" "allowed_instance_types" {
  operations = ["create", "update"]

  locals {
    instance_type = core::try(attrs.instance_type, null)
    is_allowed    = local.instance_type != null ? core::contains(input.allowed_instance_types, local.instance_type) : false
  }

  enforcement_level = "advisory"
  enforce {
    condition     = local.is_allowed
    error_message = "EC2 instance_type must be one of the approved types: ${core::join(", ", input.allowed_instance_types)}."
  }
}

