policy {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 6.69.0, < 7.0.0"
    }
  }
}

# Converted from Sentinel: EBS volumes must be encrypted.
# Evaluated on create and update only (default operations); delete is not evaluated.
resource_policy "aws_ebs_volume" "ebs_encrypted" {
  locals {
    encrypted_raw = core::try(attrs.encrypted, null)
    is_encrypted  = local.encrypted_raw != null && local.encrypted_raw == true
  }

  enforcement_level = "advisory"
  enforce {
    condition     = local.is_encrypted
    error_message = "EBS volumes must be encrypted. Set 'encrypted = true' on the aws_ebs_volume resource."
  }
}

